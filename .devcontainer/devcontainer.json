{
  "name": "Manifold ML",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13",
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}